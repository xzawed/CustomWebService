# === 데이터베이스 (임베디드 SQLite) ===
# 영속성은 Railway Volume을 /data에 마운트해 확보(미마운트 시 재배포마다 소실).
# 부팅 시 마이그레이션 + 단일 관리자/카탈로그/플래그 시드가 자동 적용된다(멱등).
# SQLITE_PATH=/data/app.db                  # 선택 (기본: /data/app.db)

# === 인증 (Auth.js v5 — Credentials 단일 관리자 + JWT 무상태) ===
AUTH_SECRET=                                # NextAuth 세션 서명 키 (필수). 예: openssl rand -base64 32
AUTH_TRUST_HOST=true                        # 커스텀 도메인/프록시 뒤에서 필수 (없으면 /api/auth/* 500)
ADMIN_EMAIL=                                # 단일 관리자 로그인 이메일 (필수)
ADMIN_PASSWORD_HASH=                        # pnpm admin:hash '<비밀번호>' 로 생성한 scrypt 해시 (필수)
NEXT_PUBLIC_AUTH_PROVIDER=local             # 클라이언트 빌드타임 상수 (현재 단일 스택)
# ADMIN_NAME=Admin                          # 선택 — 관리자 표시 이름
# ADMIN_USER_ID=00000000-0000-0000-0000-000000000001  # 선택 — 단일 관리자 users.id 고정값

# === AI ===
ANTHROPIC_API_KEY=

# AI Provider 선택 (미설정 시 claude). 현재 허용값은 claude 하나뿐 — 그 외 값은 런타임 에러
# AI_PROVIDER=claude

# Claude 모델 오버라이드 (미설정 시 아래 기본값 사용)
# 허용 모델: claude-haiku-4-5 | claude-sonnet-4-6 | claude-opus-4-6 | claude-opus-4-7
# 주의: 날짜 suffix 포함 ID(예: claude-haiku-4-5-20251001)는 Anthropic 404 반환
# AI_MODEL_SUGGESTION=claude-haiku-4-5    # 컨텍스트 추천용 (기본: haiku — 빠름·저렴)
# AI_MODEL_GENERATION=claude-opus-4-7     # 코드 생성용   (기본: opus-4-7 — 최고 품질)

# === 암호화 키 (사용자 API 키 암호화용) ===
# 생성 방법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# === GitHub (생성 서비스 배포용) ===
GITHUB_TOKEN=
GITHUB_ORG=

# === Railway (생성 서비스 배포용) ===
RAILWAY_TOKEN=

# === API 카탈로그 키 (서버 프록시가 주입 — /api/v1/proxy) ===
# 이름 규칙: API_KEY_<카탈로그 auth_config.env_var 값>
# 실제 변수명 확인: 배포 환경에서 GET /api/v1/admin/keys-verify (ADMIN_API_KEY 보호) 호출
#
# 주요 API 키 목록 (예시):
# API_KEY_OPENWEATHERMAP=          # openweathermap.org → 무료 가입 후 발급
# API_KEY_WEATHERAPICOM=           # weatherapi.com → 무료 가입 후 발급
# API_KEY_NEWSAPI=                 # newsapi.org → 무료 가입 후 발급
# API_KEY_EXCHANGERATEAPI=         # exchangerate-api.com → 무료 가입 후 발급
# API_KEY_OPENAI=                  # openai.com (이미지 생성 등)

# === 알림 / 모니터링 (선택) ===
# Slack Webhook URL — 미설정 시 알림 스킵
# SLACK_WEBHOOK_URL=
# 5분 윈도우 내 코드 생성 실패 N회 이상 시 Slack 알림 (기본: 5)
# ERROR_RATE_ALERT_THRESHOLD=5

# === 프록시 응답 캐시 (인메모리, per-instance) ===
# 프록시 응답 LRU 캐시 최대 항목 수 (기본: 500)
# PROXY_CACHE_MAX_ENTRIES=500

# === Admin ===
ADMIN_API_KEY=

# === 렌더링 QC (Playwright) ===
# Set to true to enable Playwright browser QC (recommended in production)
# Requires Chromium installed in environment (included in Dockerfile)
ENABLE_RENDERING_QC=true
# QC 타임아웃/임계값 오버라이드 (미설정 시 기본값 사용)
# QC_FAST_TIMEOUT_MS=3000       # Fast QC (구조·API) 타임아웃 (기본: 3s)
# QC_DEEP_TIMEOUT_MS=10000      # Deep QC (전체 검증) 타임아웃 (기본: 10s)
# QC_CHECK_TIMEOUT_MS=1500      # 개별 QC 체크 타임아웃 (기본: 1.5s)
# QC_QUALITY_THRESHOLD=60       # QC 합격 점수 (기본: 60)
# QC_MOBILE_THRESHOLD=60        # 모바일 QC 합격 점수 (기본: 60)

# === 기능 제한 (선택, 미설정 시 기본값 사용) ===
# MAX_APIS_PER_PROJECT=5
# MAX_DAILY_GENERATIONS=10

# === App ===
# 로컬 개발:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
#
# 운영 환경 (Railway 환경변수로 설정):
NEXT_PUBLIC_APP_URL=https://xzawed.xyz
NEXT_PUBLIC_ROOT_DOMAIN=xzawed.xyz

# =============================================================================
# CustomWebService — 로컬/셀프호스트 스타터 env
# =============================================================================
# 스택: 임베디드 SQLite + Auth.js v5 Credentials (공개 셀프서비스 회원가입 · 다중 사용자)
# 계정: `/signup` 으로 생성. env 단일 관리자(ADMIN_EMAIL 등) · `pnpm admin:hash` 는 없음.
#
# 규칙:
#   - 코드가 실제로 읽는 변수만 적는다. 전체 목록(~85)은 docs/reference/env-vars.md
#   - 시크릿 값은 절대 커밋하지 말 것. 아래는 placeholder 만.
#   - 로컬: `cp .env.example .env.local` 후 필수 칸을 채운다.
# =============================================================================

# === 데이터베이스 (임베디드 SQLite) ===
# 선택 — 미설정이면 sqlite로 동작한다(부팅 경고 1회). 'sqlite' 외의 값만 throw.
# 명시를 권장하지만 이 변수를 잃었다고 서비스가 죽지는 않는다 (assertSqliteEnv).
DB_PROVIDER=sqlite
# SQLITE_PATH=./data/app.db              # 선택 (기본: /data/app.db — 로컬은 쓰기 가능한 경로 권장)

# 자동 백업 (부팅 시 scheduleBackups — 선택, 기본 활성)
# SQLITE_BACKUP_ENABLED=true
# SQLITE_BACKUP_INTERVAL_MS=86400000     # 24h
# SQLITE_BACKUP_RETENTION=7
# SQLITE_BACKUP_DIR=                     # 미설정 시 <SQLITE_PATH 디렉터리>/backups

# === 인증 (Auth.js v5 — Credentials + JWT, 공개 회원가입) ===
AUTH_SECRET=                                # 필수. openssl rand -base64 32
AUTH_TRUST_HOST=true                        # 프록시/커스텀 도메인 뒤 필수 (없으면 /api/auth/* 500)
NEXT_PUBLIC_AUTH_PROVIDER=local             # 클라이언트 빌드타임 상수 (local 고정)
# APP_URL=http://localhost:3000             # 권장. 이메일 인증·재설정 링크 base (미설정 시 ROOT_DOMAIN→origin 폴백)
# RESEND_API_KEY=                           # 선택. 미설정 시 이메일 no-op 콘솔 폴백
# EMAIL_FROM=noreply@example.com            # RESEND_API_KEY 설정 시 필수 (빈 문자열 금지)

# === AI ===
ANTHROPIC_API_KEY=                          # 필수
# AI_PROVIDER=claude                        # 선택 (허용값: claude 만)
# 허용 모델: claude-haiku-4-5 | claude-sonnet-4-6 | claude-sonnet-5 |
#            claude-opus-4-6 | claude-opus-4-7 | claude-opus-4-8 | claude-opus-5
# 목록 밖 ID → 경고 후 태스크 기본값으로 폴백 (AiProviderFactory.ts)
# AI_MODEL_SUGGESTION=claude-haiku-4-5      # 추천 (기본: claude-haiku-4-5)
# AI_MODEL_GENERATION=claude-opus-5         # 코드 생성 (기본: claude-opus-5)
# ET_COMPLEXITY_THRESHOLD=35

# === 보안 ===
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=                             # 필수. 사용자 API 키 AES-256-GCM (32바이트 권장)
ADMIN_API_KEY=                              # 필수. /api/v1/admin/* 진단 엔드포인트

# === 앱 URL / 서브도메인 ===
# 로컬 예:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=https://xzawed.xyz
NEXT_PUBLIC_ROOT_DOMAIN=xzawed.xyz

# === 플랫폼 공유 API 키 (카탈로그 auth_config.env_var 이름 그대로) ===
# 코드에 키 이름이 하드코딩돼 있지 않다. 실제 이름:
#   node -e "const c=require('./src/data/apiCatalog.json'); for (const r of c) if (r.auth_config?.env_var) console.log(r.auth_config.env_var,'->',r.name)"
# 배포 런타임 검증: GET /api/v1/admin/keys-verify (ADMIN_API_KEY)
# API_KEY_NASA=
# API_KEY_UNSPLASH=

# === 알림 / 로그 (선택) ===
# SLACK_WEBHOOK_URL=
# ERROR_RATE_ALERT_THRESHOLD=5
# LOG_LEVEL=info

# === 렌더링 QC (Playwright, 선택) ===
# ENABLE_RENDERING_QC=false                 # true 일 때만 Chromium QC
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=      # Alpine 예: /usr/bin/chromium
# QC_QUALITY_THRESHOLD=60
# QC_MOBILE_THRESHOLD=60

# === 기능 한도 (선택 — 미설정 시 코드 기본값) ===
# MAX_APIS_PER_PROJECT=5
# MAX_DAILY_GENERATIONS=10
# MAX_DAILY_SUGGESTIONS=30
# PROXY_CACHE_MAX_ENTRIES=500

# 전체·운영 오버라이드(Quality Loop·generation lock·site 프록시 한도 등):
# → docs/reference/env-vars.md

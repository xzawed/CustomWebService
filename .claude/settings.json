{
  "permissions": {
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm start)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm type-check)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm test)",
      "Bash(pnpm test:unit)",
      "Bash(pnpm test:integration)",
      "Bash(pnpm test:coverage)",
      "Bash(pnpm test:watch)",
      "Bash(pnpm test:prod)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git tag*)",
      "Bash(git push origin --tags)",
      "Bash(railway status *)",
      "Bash(railway list *)",
      "Bash(railway link *)"
    ],
    "deny": []
  },
  "hooks": {
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{try{require('fs').appendFileSync('.claude/instructions-loaded.jsonl',d.trim()+'\\n')}catch(e){}})\""
          }
        ]
      }
    ]
  }
}

{
  "name": "custom-web-service",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/lib src/providers src/services src/repositories",
    "test:integration": "vitest run src/__tests__/api src/app/api",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:prod": "pnpm build && node -e \"const s=require('child_process').spawn('node',['.next/standalone/server.js'],{stdio:'inherit'});setTimeout(()=>{const h=require('http');h.get('http://localhost:3000/api/v1/health',r=>{console.log('healthcheck:',r.statusCode);s.kill();process.exit(r.statusCode===200?0:1)}).on('error',e=>{console.error('FAIL',e.message);s.kill();process.exit(1)})},4000)}\"",
    "countries:generate": "tsx scripts/generateCountries.ts",
    "countries:check": "tsx scripts/generateCountries.ts --check",
    "ai:contract-check": "tsx scripts/checkAiContract.ts",
    "docs:check": "tsx scripts/checkDocIntegrity.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "^3.21.0",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "happy-dom": "^20.11.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.2.0",
      "undici": "^7.28.0",
      "postcss": "^8.5.10",
      "sharp": "^0.35.3",
      "brace-expansion@^1": "^1.1.18",
      "brace-expansion@^5": "^5.0.9"
    },
    "auditConfig": {
      "ignoreGhsas": []
    },
    "onlyBuiltDependencies": []
  }
}
